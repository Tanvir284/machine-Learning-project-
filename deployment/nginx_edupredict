server {
    listen 80;
    
    # Replace with your actual EC2 Public IPv4 or Domain name
    server_name your_ec2_public_dns_or_ip;

    location / {
        include proxy_params;
        proxy_pass http://unix:/home/ubuntu/machine-Learning-project-/app.sock;
    }

    # Serve static files directly via Nginx for better performance
    location /static {
        alias /home/ubuntu/machine-Learning-project-/static;
        expires 30d;
    }
}
